LLM_PROVIDER=groq
GROQ_API_KEY=replace_with_your_key
GROQ_MODEL=openai/gpt-oss-20b

# Optional: switch LLM_PROVIDER to openrouter to use these values.
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=Incident Copilot

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
DISTANCE_THRESHOLD=1.2
RETRIEVAL_TOP_K=3
GITHUB_REPOSITORY=
GITHUB_TOKEN=
ANOMALY_WINDOW_SECONDS=5
ANOMALY_SPIKE_THRESHOLD=5
ANOMALY_COOLDOWN_SECONDS=30
